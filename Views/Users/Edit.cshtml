@model inventoryms.Models.ViewModels.Users.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    ViewData["PageTitle"] = "Edit User";
}

<div class="page-header fade-in">
    <div class="page-header-left">
        <h1>Edit User</h1>
        <p>Modify account details, role assignment, or reset password.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:var(--radius-sm);">
        <i class="fas fa-arrow-left me-2"></i>Back to Users
    </a>
</div>

<div class="row fade-in">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h2 class="card-header-title">@Model.Email</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="edit-user-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block");"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" id="full-name-input" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Role</label>
                        <select asp-for="Role" id="role-select" class="form-select"
                                asp-items="@(new SelectList(Model.AvailableRoles))">
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" id="is-active-toggle" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">Account Active</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label">
                            New Password
                            <span class="text-muted fw-normal">(leave blank to keep current)</span>
                        </label>
                        <input asp-for="NewPassword" id="new-password-input" class="form-control" type="password" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <button type="submit" id="btn-submit-edit" class="btn btn-primary">
                        <i class="fas fa-floppy-disk me-2"></i>Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

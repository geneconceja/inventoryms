@model inventoryms.Models.ViewModels.Users.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    ViewData["PageTitle"] = "Edit User";
}

<div class="page-header fade-in">
    <div class="page-header-left">
        <h1>Edit User</h1>
        <p>Modify account details, role assignment, or reset password.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left mr-2"></i>Back to Users
    </a>
</div>

<div class="max-w-2xl fade-in">
    <div class="card">
        <div class="card-header">
            <h2 class="card-header-title">@Model.Email</h2>
        </div>
        <div class="card-body p-6">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="edit-user-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4">
                        <i class="fas fa-exclamation-circle text-base"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" id="full-name-input" class="form-control" />
                    <span asp-validation-for="FullName" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" id="role-select" class="form-select"
                            asp-items="@(new SelectList(Model.AvailableRoles))">
                    </select>
                    <span asp-validation-for="Role" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="mb-4 flex items-center gap-3">
                    <input asp-for="IsActive" id="is-active-toggle" class="w-4 h-4 cursor-pointer" type="checkbox" />
                    <label asp-for="IsActive" class="text-sm font-semibold text-[#0E2F44] cursor-pointer">Account Active</label>
                </div>

                <div class="mb-6">
                    <label asp-for="NewPassword" class="form-label">
                        New Password
                        <span class="text-[#4F6B7A] font-normal normal-case ml-1">(leave blank to keep current)</span>
                    </label>
                    <input asp-for="NewPassword" id="new-password-input" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <button type="submit" id="btn-submit-edit" class="btn btn-primary">
                    <i class="fas fa-floppy-disk mr-2"></i>Save Changes
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

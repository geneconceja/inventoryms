@model IEnumerable<inventoryms.Models.ViewModels.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "User Management";
    ViewData["PageTitle"] = "User Management";
}

<div class="page-header fade-in">
    <div class="page-header-left">
        <h1>User Management</h1>
        <p>Manage system accounts and role assignments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary" id="btn-create-user">
        <i class="fas fa-plus mr-2"></i>New User
    </a>
</div>

<!-- Search -->
<form method="get" class="mb-6 flex gap-2 max-w-sm">
    <input type="text"
           name="search"
           value="@ViewBag.Search"
           class="form-control"
           id="user-search"
           placeholder="Search by name or email…" />
    <button type="submit" class="btn btn-outline-primary" id="btn-search-users" title="Search">
        <i class="fas fa-search"></i>
    </button>
</form>

<div class="card fade-in">
    <div class="card-header flex justify-between items-center">
        <h2 class="card-header-title">All Users</h2>
        <span class="text-xs text-[#4F6B7A] font-medium">@Model.Count() total</span>
    </div>
    <div class="table-wrapper">
        <table class="table" id="users-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="w-28 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-[#4F6B7A] py-8 text-sm">
                            <i class="fas fa-users-slash text-2xl mb-2 block opacity-30"></i>
                            No users found.
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    var roleCls = user.Role switch {
                        "Admin"   => "admin",
                        "Manager" => "manager",
                        _         => "staff"
                    };
                    <tr>
                        <td>
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 bg-[#146C94] flex items-center justify-center text-white text-xs font-bold shrink-0">
                                    @(string.Concat(user.FullName.Split(' ').Take(2).Select(w => char.ToUpper(w[0]))))
                                </div>
                                <span class="font-medium text-sm text-[#0E2F44]">@user.FullName</span>
                            </div>
                        </td>
                        <td class="text-[#4F6B7A] text-sm">@user.Email</td>
                        <td><span class="badge-role @roleCls">@user.Role</span></td>
                        <td>
                            <span class="badge-status @(user.IsActive ? "active" : "inactive")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-[#4F6B7A] text-xs font-mono">
                            @user.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                        </td>
                        <td>
                            <div class="flex gap-1.5 justify-center">
                                <a asp-action="Edit" asp-route-id="@user.Id"
                                   class="btn-icon"
                                   id="btn-edit-@user.Id"
                                   title="Edit user">
                                    <i class="fas fa-pen-to-square text-xs"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn-icon"
                                            id="btn-toggle-@user.Id"
                                            title="@(user.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fas @(user.IsActive ? "fa-ban" : "fa-check") text-xs"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

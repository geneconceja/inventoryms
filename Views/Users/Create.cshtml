@model inventoryms.Models.ViewModels.Users.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
    ViewData["PageTitle"] = "Create User";
}

<div class="page-header fade-in">
    <div class="page-header-left">
        <h1>Create User</h1>
        <p>Add a new system account and assign a role.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left mr-2"></i>Back to Users
    </a>
</div>

<div class="max-w-2xl fade-in">
    <div class="card">
        <div class="card-header">
            <h2 class="card-header-title">Account Details</h2>
        </div>
        <div class="card-body p-6">
            <form asp-action="Create" method="post" id="create-user-form">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4">
                        <i class="fas fa-exclamation-circle text-base"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" id="full-name-input" class="form-control" placeholder="e.g. Jane Smith" />
                    <span asp-validation-for="FullName" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" id="email-input" class="form-control" type="email" placeholder="user@example.com" />
                    <span asp-validation-for="Email" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" id="password-input" class="form-control" type="password" placeholder="Min. 6 characters" />
                    <span asp-validation-for="Password" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" id="role-select" class="form-select"
                            asp-items="@(new SelectList(Model.AvailableRoles))">
                    </select>
                    <span asp-validation-for="Role" class="text-xs text-[#B91C1C] mt-1 block"></span>
                    <div class="mt-2.5 p-3 bg-[#F6F1F1] border border-[#D8DEE6] text-xs text-[#4F6B7A]">
                        <i class="fas fa-info-circle mr-1.5 text-[#146C94]"></i>
                        <strong>Admin</strong>: full access &nbsp;|&nbsp;
                        <strong>Manager</strong>: catalog &amp; orders &nbsp;|&nbsp;
                        <strong>Staff</strong>: stock operations only
                    </div>
                </div>

                <button type="submit" id="btn-submit-create" class="btn btn-primary">
                    <i class="fas fa-user-plus mr-2"></i>Create User
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

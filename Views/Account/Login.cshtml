@model inventoryms.Models.ViewModels.Account.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In — InventoryMS";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sign in to InventoryMS — Multi-warehouse inventory management system." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-[#146C94]">
<div class="auth-page">
    <div class="auth-card fade-in">

        <!-- Header -->
        <div class="auth-card-header">
            <div class="auth-logo">
                <img src="~/logo.png" alt="InventoryMS" />
            </div>
            <h1 class="auth-title">InventoryMS</h1>
        </div>

        <!-- Body -->
        <div class="auth-card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <i class="fas fa-exclamation-circle text-base"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <!-- Demo hint for development -->
            @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
            {
                <div class="auth-hint">
                    <i class="fas fa-info-circle mr-1"></i>
                    Default admin: <code>admin@inventoryms.local</code> / <code>Admin123!</code>
                </div>
            }

            <form id="login-form" asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text border-r-0">
                            <i class="fas fa-envelope fa-sm"></i>
                        </span>
                        <input asp-for="Email"
                               id="email-input"
                               class="form-control border-l-0 pl-1"
                               type="email"
                               autocomplete="email"
                               placeholder="you@example.com"
                               autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text border-r-0">
                            <i class="fas fa-lock fa-sm"></i>
                        </span>
                        <input asp-for="Password"
                               id="password-input"
                               class="form-control border-l-0 border-r-0 pl-1"
                               type="password"
                               autocomplete="current-password"
                               placeholder="••••••••" />
                        <button type="button"
                                id="toggle-password"
                                class="input-group-text bg-white border-l-0 cursor-pointer hover:bg-slate-50"
                                title="Toggle password visibility">
                            <i class="fas fa-eye fa-sm" id="toggle-icon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-xs text-[#B91C1C] mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between mb-5">
                    <div class="form-check">
                        <input asp-for="RememberMe" id="remember-me" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label select-none">
                            Remember me
                        </label>
                    </div>
                </div>

                <button type="submit" id="login-btn" class="btn btn-auth">
                    <span class="btn-text">Sign In</span>
                </button>
            </form>
        </div>

        <div class="text-center pb-5 text-xs text-[#4F6B7A]">
            &copy; @DateTime.Now.Year InventoryMS &mdash; All rights reserved
        </div>
    </div>
</div>

<script>
    // Password visibility toggle
    document.getElementById('toggle-password').addEventListener('click', function () {
        const pwInput = document.getElementById('password-input');
        const icon = document.getElementById('toggle-icon');
        if (pwInput.type === 'password') {
            pwInput.type = 'text';
            icon.className = 'fas fa-eye-slash fa-sm text-slate-500';
        } else {
            pwInput.type = 'password';
            icon.className = 'fas fa-eye fa-sm text-slate-500';
        }
    });

    // Loading state on submit
    document.getElementById('login-form').addEventListener('submit', function () {
        const btn = document.getElementById('login-btn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Signing in...';
        btn.disabled = true;
    });
</script>
</body>
</html>

@model inventoryms.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="page-header mb-6">
    <div class="page-header-left">
        <h1 class="text-xl font-bold text-[#146C94]">Dashboard</h1>
        <p class="text-xs text-[#4F6B7A] mt-0.5">
            Active Tenant: <strong class="text-[#146C94]">@Model.OrganizationName</strong>
            <span class="badge-role admin ml-2 font-mono">TENANT-SCOPED</span>
        </p>
    </div>
    <div class="page-header-actions">
        <span class="text-xs text-[#4F6B7A] flex items-center gap-1.5">
            <i class="fas fa-database text-[#146C94]"></i> Isolated PostgreSQL Scope
        </span>
    </div>
</div>

<!-- Tenant Isolation Callout -->
<div class="card mb-6 border-l-4 border-l-[#19A7CE] bg-[#FAFDFE]">
    <div class="card-body p-4">
        <div class="flex items-center gap-3">
            <div class="text-[#146C94] text-2xl flex-shrink-0">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <div class="font-bold text-[#146C94] text-sm">Multi-Tenancy Row-Level Isolation Active</div>
                <div class="text-xs text-[#4F6B7A] mt-0.5">
                    You are currently viewing data for <strong>@Model.OrganizationName</strong>.
                    To switch between organizations, use the <strong>Organization Switcher</strong> dropdown in the left sidebar.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="stat-card">
        <div class="stat-icon primary">
            <i class="fas fa-warehouse"></i>
        </div>
        <div>
            <div class="stat-value">@Model.Warehouses.Count</div>
            <div class="stat-label">Warehouses</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon accent">
            <i class="fas fa-tags"></i>
        </div>
        <div>
            <div class="stat-value">@Model.Categories.Count</div>
            <div class="stat-label">Categories</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success">
            <i class="fas fa-truck"></i>
        </div>
        <div>
            <div class="stat-value">@Model.Suppliers.Count</div>
            <div class="stat-label">Suppliers</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-building"></i>
        </div>
        <div class="min-w-0">
            <div class="stat-value truncate text-base font-sans" title="@Model.OrganizationName">
                @Model.OrganizationName
            </div>
            <div class="stat-label">Active Organization</div>
        </div>
    </div>
</div>

<!-- Detailed Data Scopes -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Warehouses Table -->
    <div class="card flex flex-col h-full">
        <div class="card-header flex justify-between items-center">
            <span class="card-header-title flex items-center gap-2">
                <i class="fas fa-warehouse text-[#146C94]"></i>
                Scoped Warehouses (@Model.Warehouses.Count)
            </span>
        </div>
        <div class="table-responsive flex-1">
            <table class="table">
                <thead>
                    <tr>
                        <th>Warehouse Name</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Warehouses.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center text-[#4F6B7A] py-6 text-xs">No warehouses configured for this tenant.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var wh in Model.Warehouses)
                        {
                            <tr>
                                <td class="font-semibold">
                                    <i class="fas fa-map-marker-alt text-[#4F6B7A] mr-2 text-xs"></i>@wh.Name
                                </td>
                                <td class="text-[#4F6B7A]">@wh.Location</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="card flex flex-col h-full">
        <div class="card-header flex justify-between items-center">
            <span class="card-header-title flex items-center gap-2">
                <i class="fas fa-tags text-[#146C94]"></i>
                Scoped Categories (@Model.Categories.Count)
            </span>
        </div>
        <div class="table-responsive flex-1">
            <table class="table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Categories.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center text-[#4F6B7A] py-6 text-xs">No categories configured for this tenant.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td class="font-semibold">@cat.Name</td>
                                <td class="text-[#4F6B7A] text-xs">@cat.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Suppliers Table -->
<div class="card mb-6">
    <div class="card-header flex justify-between items-center">
        <span class="card-header-title flex items-center gap-2">
            <i class="fas fa-truck text-[#146C94]"></i>
            Scoped Suppliers (@Model.Suppliers.Count)
        </span>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Supplier Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Suppliers.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-[#4F6B7A] py-6 text-xs">No suppliers configured for this tenant.</td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model.Suppliers)
                    {
                        <tr>
                            <td class="font-semibold">@s.Name</td>
                            <td>@(string.IsNullOrEmpty(s.ContactName) ? "—" : s.ContactName)</td>
                            <td class="font-mono text-xs">@(string.IsNullOrEmpty(s.Email) ? "—" : s.Email)</td>
                            <td class="font-mono text-xs">@(string.IsNullOrEmpty(s.Phone) ? "—" : s.Phone)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

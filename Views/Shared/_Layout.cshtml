@using Microsoft.AspNetCore.Identity
@inject SignInManager<inventoryms.Models.ApplicationUser> SignInManager
@inject UserManager<inventoryms.Models.ApplicationUser> UserManager
@inject inventoryms.Services.ITenantService TenantService

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAuthenticated = SignInManager.IsSignedIn(User);
    var isAdmin   = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager");
    var currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var pageTitle = ViewData["PageTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "Dashboard";
    var currentTenantId = TenantService.CurrentTenantId;
    var currentTenantName = TenantService.CurrentTenantName ?? "No Organization";
    var userTenants = isAuthenticated ? await TenantService.GetUserTenantsAsync() : Array.Empty<inventoryms.Services.TenantDto>();

    string NavClass(string ctrl) => controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
        ? "sidebar-link active" : "sidebar-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — InventoryMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/inventoryms.styles.css" asp-append-version="true" />
</head>
<body>

@if (isAuthenticated)
{
    <div class="app-wrapper">
        <!-- ========== SIDEBAR ========== -->
        <aside class="sidebar" id="sidebar">
            <!-- Brand -->
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <img src="~/logo.png" alt="InventoryMS" />
                </div>
                <div>
                    <span class="sidebar-brand-text">InventoryMS</span>
                    <span class="sidebar-brand-sub">Inventory Management</span>
                </div>
            </a>

            <!-- Organization Switcher -->
            @if (userTenants.Count > 0)
            {
                <div class="sidebar-tenant-switcher">
                    <div class="sidebar-section-label">Organization</div>
                    <div class="relative">
                        <button class="btn-tenant-switch"
                                type="button"
                                id="tenantSwitcherDropdown"
                                onclick="toggleTenantDropdown()">
                            <i class="fas fa-building me-2"></i>
                            <span class="tenant-switch-name">@currentTenantName</span>
                            <i class="fas fa-chevron-down ms-auto" style="font-size:0.75rem; color:var(--color-brand-powder);"></i>
                        </button>
                        <ul class="dropdown-menu-tenant" id="tenantDropdownMenu">
                            @foreach (var tenant in userTenants)
                            {
                                <li>
                                    <form asp-controller="Tenant" asp-action="Switch" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tenantId" value="@tenant.Id" />
                                        <button type="submit"
                                                class="dropdown-item @(tenant.Id == currentTenantId ? "active" : "")">
                                            <i class="fas fa-building me-2"></i>
                                            <span class="flex-1">@tenant.Name</span>
                                            @if (tenant.Id == currentTenantId)
                                            {
                                                <i class="fas fa-check ms-auto"></i>
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Navigation -->
            <nav class="sidebar-nav">
                <div class="sidebar-section-label">Overview</div>
                <a asp-controller="Home" asp-action="Index" class="@NavClass("Home")">
                    <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                    Dashboard
                </a>

                <div class="sidebar-section-label">Catalog</div>
                <a asp-controller="Products" asp-action="Index" class="@NavClass("Products")">
                    <span class="nav-icon"><i class="fas fa-box"></i></span>
                    Products
                </a>
                <a asp-controller="Categories" asp-action="Index" class="@NavClass("Categories")">
                    <span class="nav-icon"><i class="fas fa-tags"></i></span>
                    Categories
                </a>
                <a asp-controller="Suppliers" asp-action="Index" class="@NavClass("Suppliers")">
                    <span class="nav-icon"><i class="fas fa-truck"></i></span>
                    Suppliers
                </a>
                <a asp-controller="Warehouses" asp-action="Index" class="@NavClass("Warehouses")">
                    <span class="nav-icon"><i class="fas fa-warehouse"></i></span>
                    Warehouses
                </a>

                <div class="sidebar-section-label">Operations</div>
                <a asp-controller="StockTransactions" asp-action="Index" class="@NavClass("StockTransactions")">
                    <span class="nav-icon"><i class="fas fa-arrows-rotate"></i></span>
                    Stock Transactions
                </a>

                @if (isAdmin || isManager)
                {
                    <a asp-controller="PurchaseOrders" asp-action="Index" class="@NavClass("PurchaseOrders")">
                        <span class="nav-icon"><i class="fas fa-file-invoice"></i></span>
                        Purchase Orders
                    </a>
                }

                @if (isAdmin)
                {
                    <div class="sidebar-section-label">Administration</div>
                    <a asp-controller="Users" asp-action="Index" class="@NavClass("Users")">
                        <span class="nav-icon"><i class="fas fa-users-gear"></i></span>
                        User Management
                    </a>
                }
            </nav>

            <!-- User Footer -->
            <div class="sidebar-footer">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </aside>

        <!-- ========== MAIN CONTENT ========== -->
        <div class="main-content">
            <!-- Top Bar -->
            <header class="topbar">
                <span class="topbar-title">@pageTitle</span>
                <div class="topbar-actions">
                    @if (TempData["Success"] != null)
                    {
                        <span class="inline-flex items-center text-xs font-semibold px-3 py-1 bg-[#DCFCE7] text-[#15803D] border border-[#86EFAC]">
                            <i class="fas fa-check me-1.5"></i>@TempData["Success"]
                        </span>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <span class="inline-flex items-center text-xs font-semibold px-3 py-1 bg-[#FEE2E2] text-[#B91C1C] border border-[#FECACA]">
                            <i class="fas fa-exclamation-circle me-1.5"></i>@TempData["Error"]
                        </span>
                    }
                </div>
            </header>

            <!-- Page Body -->
            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <!-- Unauthenticated: plain container for redirected pages -->
    <main role="main">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
